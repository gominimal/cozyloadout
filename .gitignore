# Build output. `just theme` deletes and rewrites build/ on every run.
# The zip is named after the loadout (LOADOUT in the justfile).
/build/
/*.zip

# Renderer build artifacts.
/tools/cozy-theme/target/
**/*.rs.bk

# The upstream scheme collection, cloned by `just fetch-schemes`.
/schemes/vendor/

# macOS
.DS_Store
