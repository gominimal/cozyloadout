# Build output. `just theme` deletes and rewrites build/ on every run.
# The zip is named after the loadout (LOADOUT in the justfile).
/build/
/*.zip

# Renderer build artifacts.
/tools/cozy-theme/target/
**/*.rs.bk

# The upstream scheme collection, cloned by `just fetch-schemes`.
/schemes/vendor/

# macOS
.DS_Store

# What the wizard remembered between runs, before those answers moved to
# ~/.config/cozy/settings.toml. Still read when it is the only one there, so an
# older checkout does not lose its answers; never written again.
/.cozy-wizard.toml

# Per-developer Claude Code permissions; the shared config is .claude/settings.json.
/.claude/settings.local.json
