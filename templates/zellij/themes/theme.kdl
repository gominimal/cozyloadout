// {{scheme-name}} — zellij theme.
//
// GENERATED by `just theme` from schemes/{{scheme-slug}}.yaml.
// Edit templates/zellij/themes/theme.kdl instead; see AGENTS.md.
//
// Uses zellij's UI-component theme spec (0.41+), not the legacy base-colors
// block: the component spec states every surface explicitly, so a light scheme
// doesn't have to fight the legacy format's dark-theme assumptions.
//
// Selected by `theme "{{scheme-slug}}"` in config.kdl.

themes {
    {{scheme-slug}} {
        // Body text — base05 on base00
        text_unselected {
            base "#{{base05-hex}}"
            background "#{{base00-hex}}"
            emphasis_0 "#{{base09-hex}}" // base09 orange
            emphasis_1 "#{{base0D-hex}}" // base0D blue
            emphasis_2 "#{{base0B-hex}}" // base0B green
            emphasis_3 "#{{base0E-hex}}" // base0E purple
        }
        text_selected {
            base "#{{base05-hex}}"
            background "#{{base02-hex}}" // base02 — selection
            emphasis_0 "#{{base09-hex}}"
            emphasis_1 "#{{base0D-hex}}"
            emphasis_2 "#{{base0B-hex}}"
            emphasis_3 "#{{base0E-hex}}"
        }

        // Active mode/tab ribbon — blue, matching helix's NORMAL statusline
        ribbon_selected {
            base "#{{base00-hex}}"
            background "#{{base0D-hex}}" // base0D
            emphasis_0 "#{{base00-hex}}"
            emphasis_1 "#{{base07-hex}}"
            emphasis_2 "#{{base00-hex}}"
            emphasis_3 "#{{base07-hex}}"
        }
        ribbon_unselected {
            base "#{{base04-hex}}" // base04 — --muted-foreground
            background "#{{base01-hex}}" // base01 — --card
            emphasis_0 "#{{base09-hex}}"
            emphasis_1 "#{{base05-hex}}"
            emphasis_2 "#{{base0B-hex}}"
            emphasis_3 "#{{base0E-hex}}"
        }

        table_title {
            base "#{{base0D-hex}}" // base0D — headings
            background "#{{base00-hex}}"
            emphasis_0 "#{{base09-hex}}"
            emphasis_1 "#{{base0D-hex}}"
            emphasis_2 "#{{base0B-hex}}"
            emphasis_3 "#{{base0E-hex}}"
        }
        table_cell_unselected {
            base "#{{base05-hex}}"
            background "#{{base00-hex}}"
            emphasis_0 "#{{base09-hex}}"
            emphasis_1 "#{{base0D-hex}}"
            emphasis_2 "#{{base0B-hex}}"
            emphasis_3 "#{{base0E-hex}}"
        }
        table_cell_selected {
            base "#{{base05-hex}}"
            background "#{{base02-hex}}"
            emphasis_0 "#{{base09-hex}}"
            emphasis_1 "#{{base0D-hex}}"
            emphasis_2 "#{{base0B-hex}}"
            emphasis_3 "#{{base0E-hex}}"
        }

        list_unselected {
            base "#{{base05-hex}}"
            background "#{{base00-hex}}"
            emphasis_0 "#{{base09-hex}}"
            emphasis_1 "#{{base0D-hex}}"
            emphasis_2 "#{{base0B-hex}}"
            emphasis_3 "#{{base0E-hex}}"
        }
        list_selected {
            base "#{{base05-hex}}"
            background "#{{base02-hex}}"
            emphasis_0 "#{{base09-hex}}"
            emphasis_1 "#{{base0D-hex}}"
            emphasis_2 "#{{base0B-hex}}"
            emphasis_3 "#{{base0E-hex}}"
        }

        // Pane frames
        frame_unselected {
            base "#{{base02-hex}}" // base02 — --border
            emphasis_0 "#{{base09-hex}}"
            emphasis_1 "#{{base0D-hex}}"
            emphasis_2 "#{{base0B-hex}}"
            emphasis_3 "#{{base0E-hex}}"
        }
        frame_selected {
            base "#{{base0D-hex}}" // base0D — focused pane
            emphasis_0 "#{{base09-hex}}"
            emphasis_1 "#{{base0D-hex}}"
            emphasis_2 "#{{base0B-hex}}"
            emphasis_3 "#{{base0E-hex}}"
        }
        frame_highlight {
            base "#{{base09-hex}}" // base09 — search / rename
            emphasis_0 "#{{base08-hex}}"
            emphasis_1 "#{{base09-hex}}"
            emphasis_2 "#{{base0A-hex}}"
            emphasis_3 "#{{base0E-hex}}"
        }

        exit_code_success {
            base "#{{base0B-hex}}" // base0B
            background "#{{base00-hex}}"
            emphasis_0 "#{{base0A-hex}}"
            emphasis_1 "#{{base0D-hex}}"
            emphasis_2 "#{{base0B-hex}}"
            emphasis_3 "#{{base0E-hex}}"
        }
        exit_code_error {
            base "#{{base08-hex}}" // base08
            background "#{{base00-hex}}"
            emphasis_0 "#{{base0A-hex}}"
            emphasis_1 "#{{base0D-hex}}"
            emphasis_2 "#{{base0B-hex}}"
            emphasis_3 "#{{base0E-hex}}"
        }

        multiplayer_user_colors {
            player_1 "#{{base0D-hex}}" // base0D
            player_2 "#{{base0E-hex}}" // base0E
            player_3 "#{{base0B-hex}}" // base0B
            player_4 "#{{base09-hex}}" // base09
            player_5 "#{{base0C-hex}}" // base0C
            player_6 "#{{base0A-hex}}" // base0A
            player_7 "#{{base08-hex}}" // base08
            player_8 "#{{base0F-hex}}" // base0F
            player_9 "#{{base04-hex}}" // base04
            player_10 "#{{base06-hex}}" // base06
        }
    }
}
