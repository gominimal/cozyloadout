// {{scheme_name}} — zellij theme.
//
// GENERATED by `just theme` from schemes/{{scheme_slug}}.yaml.
// Edit templates/zellij/themes/theme.kdl instead; see AGENTS.md.
//
// Uses zellij's UI-component theme spec (0.41+), not the legacy base-colors
// block: the component spec states every surface explicitly, so a light scheme
// doesn't have to fight the legacy format's dark-theme assumptions.
//
// Selected by `theme "{{scheme_slug}}"` in config.kdl.

themes {
    {{scheme_slug}} {
        // Body text — base05 on base00
        text_unselected {
            base "#{{base05_hex}}"
            background "#{{base00_hex}}"
            emphasis_0 "#{{base09_hex}}" // base09 orange
            emphasis_1 "#{{base0D_hex}}" // base0D blue
            emphasis_2 "#{{base0B_hex}}" // base0B green
            emphasis_3 "#{{base0E_hex}}" // base0E purple
        }
        text_selected {
            base "#{{base05_hex}}"
            background "#{{base02_hex}}" // base02 — selection
            emphasis_0 "#{{base09_hex}}"
            emphasis_1 "#{{base0D_hex}}"
            emphasis_2 "#{{base0B_hex}}"
            emphasis_3 "#{{base0E_hex}}"
        }

        // Active mode/tab ribbon — blue, matching helix's NORMAL statusline
        ribbon_selected {
            base "#{{base00_hex}}"
            background "#{{base0D_hex}}" // base0D
            emphasis_0 "#{{base00_hex}}"
            emphasis_1 "#{{base07_hex}}"
            emphasis_2 "#{{base00_hex}}"
            emphasis_3 "#{{base07_hex}}"
        }
        ribbon_unselected {
            base "#{{base04_hex}}" // base04 — --muted-foreground
            background "#{{base01_hex}}" // base01 — --card
            emphasis_0 "#{{base09_hex}}"
            emphasis_1 "#{{base05_hex}}"
            emphasis_2 "#{{base0B_hex}}"
            emphasis_3 "#{{base0E_hex}}"
        }

        table_title {
            base "#{{base0D_hex}}" // base0D — headings
            background "#{{base00_hex}}"
            emphasis_0 "#{{base09_hex}}"
            emphasis_1 "#{{base0D_hex}}"
            emphasis_2 "#{{base0B_hex}}"
            emphasis_3 "#{{base0E_hex}}"
        }
        table_cell_unselected {
            base "#{{base05_hex}}"
            background "#{{base00_hex}}"
            emphasis_0 "#{{base09_hex}}"
            emphasis_1 "#{{base0D_hex}}"
            emphasis_2 "#{{base0B_hex}}"
            emphasis_3 "#{{base0E_hex}}"
        }
        table_cell_selected {
            base "#{{base05_hex}}"
            background "#{{base02_hex}}"
            emphasis_0 "#{{base09_hex}}"
            emphasis_1 "#{{base0D_hex}}"
            emphasis_2 "#{{base0B_hex}}"
            emphasis_3 "#{{base0E_hex}}"
        }

        list_unselected {
            base "#{{base05_hex}}"
            background "#{{base00_hex}}"
            emphasis_0 "#{{base09_hex}}"
            emphasis_1 "#{{base0D_hex}}"
            emphasis_2 "#{{base0B_hex}}"
            emphasis_3 "#{{base0E_hex}}"
        }
        list_selected {
            base "#{{base05_hex}}"
            background "#{{base02_hex}}"
            emphasis_0 "#{{base09_hex}}"
            emphasis_1 "#{{base0D_hex}}"
            emphasis_2 "#{{base0B_hex}}"
            emphasis_3 "#{{base0E_hex}}"
        }

        // Pane frames
        frame_unselected {
            base "#{{base02_hex}}" // base02 — --border
            emphasis_0 "#{{base09_hex}}"
            emphasis_1 "#{{base0D_hex}}"
            emphasis_2 "#{{base0B_hex}}"
            emphasis_3 "#{{base0E_hex}}"
        }
        frame_selected {
            base "#{{base0D_hex}}" // base0D — focused pane
            emphasis_0 "#{{base09_hex}}"
            emphasis_1 "#{{base0D_hex}}"
            emphasis_2 "#{{base0B_hex}}"
            emphasis_3 "#{{base0E_hex}}"
        }
        frame_highlight {
            base "#{{base09_hex}}" // base09 — search / rename
            emphasis_0 "#{{base08_hex}}"
            emphasis_1 "#{{base09_hex}}"
            emphasis_2 "#{{base0A_hex}}"
            emphasis_3 "#{{base0E_hex}}"
        }

        exit_code_success {
            base "#{{base0B_hex}}" // base0B
            background "#{{base00_hex}}"
            emphasis_0 "#{{base0A_hex}}"
            emphasis_1 "#{{base0D_hex}}"
            emphasis_2 "#{{base0B_hex}}"
            emphasis_3 "#{{base0E_hex}}"
        }
        exit_code_error {
            base "#{{base08_hex}}" // base08
            background "#{{base00_hex}}"
            emphasis_0 "#{{base0A_hex}}"
            emphasis_1 "#{{base0D_hex}}"
            emphasis_2 "#{{base0B_hex}}"
            emphasis_3 "#{{base0E_hex}}"
        }

        multiplayer_user_colors {
            player_1 "#{{base0D_hex}}" // base0D
            player_2 "#{{base0E_hex}}" // base0E
            player_3 "#{{base0B_hex}}" // base0B
            player_4 "#{{base09_hex}}" // base09
            player_5 "#{{base0C_hex}}" // base0C
            player_6 "#{{base0A_hex}}" // base0A
            player_7 "#{{base08_hex}}" // base08
            player_8 "#{{base0F_hex}}" // base0F
            player_9 "#{{base04_hex}}" // base04
            player_10 "#{{base06_hex}}" // base06
        }
    }
}
