# {{scheme-name}} — delta.
#
# GENERATED by `just theme` from schemes/{{scheme-slug}}.yaml.
# Edit templates/delta/delta.gitconfig instead; see AGENTS.md.
#
# delta has no config file of its own; it reads its settings out of git config.
# This file is therefore an *include*, not a replacement for your ~/.gitconfig —
# the loadout drops it at ~/.config/git/{{loadout-name}}-delta.gitconfig and git
# is pointed at it by the on_activate lifecycle hook, with:
#
#     git config --global --add include.path ~/.config/git/{{loadout-name}}-delta.gitconfig
#
# --add rather than a plain set, and only after checking the existing values:
# `git config --global include.path X` replaces what is already there, which
# would silently drop an include of your own.
#
# Syntax highlighting inside diffs comes from bat's theme cache, so this depends
# on {{loadout-name}}/bat/themes/{{scheme-slug}}.tmTheme being installed and bat's cache
# rebuilt — which the on_activate lifecycle hook does.
#
# Every style value is quoted on purpose: in git config `#` starts a comment, so
# an unquoted `minus-style = syntax #341919` parses as an empty value and delta
# silently falls back to its defaults.

# Styling delta is not enough to make git *use* it: delta is a pager, and git
# picks one from GIT_PAGER, then core.pager, then $PAGER, then its built-in
# less. Without the two settings below, every `[delta]` section in this file is
# inert and diffs page through whatever $PAGER holds — which the loadout sets to
# `bat`. `diffFilter` is the same wiring for `git add -p`, where delta filters
# the diff rather than paging it.
#
# Note this include is *appended* to your git config, and git takes the last
# value of a single-valued key, so these win over a core.pager you set earlier.
# That is the intent — the loadout is what put delta in the session — but it is
# the one place the include overrides rather than adds.
[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	features = {{scheme-slug}}

	# The line-numbers-*-style settings below only render with this on.
	line-numbers = true

[delta "{{scheme-slug}}"]
	{{#dark}}dark = true{{/dark}}{{#light}}light = true{{/light}}
	syntax-theme = {{scheme-slug}}

	# Diff bodies. Foreground stays "syntax" so bat's highlighting survives; the
	# backgrounds are base08/base0B blended into base00 at 15% (body) and 30%
	# (emphasised word-level change) — see AGENTS.md.
	minus-style = "syntax #{{mix base08 base00 15}}"
	minus-emph-style = "syntax #{{mix base08 base00 30}}"
	minus-non-emph-style = "syntax #{{mix base08 base00 15}}"
	plus-style = "syntax #{{mix base0B base00 15}}"
	plus-emph-style = "syntax #{{mix base0B base00 30}}"
	plus-non-emph-style = "syntax #{{mix base0B base00 15}}"
	zero-style = "syntax"
	whitespace-error-style = "#{{base00-hex}} #{{base08-hex}}"

	# Moved lines. Requires `diff.colorMoved`, which the loadout's other git
	# include sets — the two halves are useless apart, so if you drop one, drop
	# both.
	#
	# The mechanism is worth knowing, because it is not delta's usual one:
	# delta cannot detect a moved block itself. git does that, and with
	# `colorMoved` on it marks the result by *recolouring* those lines in the
	# diff it hands its pager — bold magenta for the old location, bold cyan for
	# the new. `map-styles` matches on those incoming colours and substitutes
	# its own. So the two keys below are not palette choices; they are git's
	# hardcoded move colours, spelled the way delta names them (`purple` is
	# git's magenta), and they must be matched verbatim or the rule never fires.
	#
	# Without this the lines still render — in git's bold cyan, off-scheme, with
	# the syntax highlighting overwritten, which is worse than not detecting
	# moves at all. Verified against git 2.55 / delta 0.19.
	#
	# base0E (purple) and base0D (blue) over base00 at 15%, the same blend the
	# minus/plus bodies use, so a moved block reads as a third kind of change
	# next to them rather than as an unrelated highlight. Foreground stays
	# "syntax" for the same reason it does above.
	map-styles = "bold purple => syntax #{{mix base0E base00 15}}, bold cyan => syntax #{{mix base0D base00 15}}"

	# Gutter
	line-numbers-minus-style = "#{{base08-hex}}"
	line-numbers-plus-style = "#{{base0B-hex}}"
	line-numbers-zero-style = "#{{base03-hex}}"
	line-numbers-left-style = "#{{base02-hex}}"
	line-numbers-right-style = "#{{base02-hex}}"

	# Headers — blue file names and yellow commits, matching helix's headings
	# and zellij's active ribbon.
	file-style = "bold #{{base0D-hex}}"
	file-decoration-style = "#{{base02-hex}} ul"
	hunk-header-style = "file line-number syntax"
	hunk-header-decoration-style = "#{{base02-hex}} box"
	hunk-header-file-style = "#{{base04-hex}}"
	hunk-header-line-number-style = "#{{base09-hex}}"
	commit-style = "bold #{{base0A-hex}}"
	commit-decoration-style = "#{{base02-hex}} box"

	# `git blame` via delta: base00 → base01 → base02 as the block ages.
	blame-code-style = "syntax"
	blame-palette = "#{{base00-hex}} #{{base01-hex}} #{{base02-hex}}"

	# `delta --grep` / rg piped through delta
	grep-file-style = "#{{base0D-hex}}"
	grep-line-number-style = "#{{base09-hex}}"

	merge-conflict-ours-diff-header-style = "bold #{{base0A-hex}}"
	merge-conflict-ours-diff-header-decoration-style = "#{{base02-hex}} box"
	merge-conflict-theirs-diff-header-style = "bold #{{base0A-hex}}"
	merge-conflict-theirs-diff-header-decoration-style = "#{{base02-hex}} box"
