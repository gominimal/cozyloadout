// broot — {{scheme-name}}.
//
// GENERATED by `just theme` — see AGENTS.md.
//
// This file replaces the conf.hjson broot writes on first run, so it only
// carries the skin import: broot's verbs, preview transformers and search modes
// are all built in and keep working untouched.
//
// If you keep your own verbs in ~/.config/broot/verbs.hjson, add `verbs.hjson`
// back to the imports list below — broot does not import it implicitly, and a
// missing import is a hard error, so it is left out here rather than shipped
// pointing at a file that may not exist.

imports: [
	skins/{{scheme-slug}}.hjson
]
