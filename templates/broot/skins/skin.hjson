// {{scheme_name}} — broot skin.
//
// GENERATED by `just theme` from schemes/{{scheme_slug}}.yaml.
// Edit templates/broot/skins/skin.hjson instead; see AGENTS.md.
//
// broot skin entries are "foreground background attributes", with a second
// "/ foreground background" group for the unfocused panel. `none` means "leave
// it to the terminal". The key set below is broot's full one (checked against
// the skins broot ships) — unknown keys are ignored silently, so a typo shows
// up as an unstyled widget rather than an error.
//
// Skin reference: https://dystroy.org/broot/skins/

skin: {
	// --- Surfaces ------------------------------------------------------------
	// base05 on base00, dimming to base04 on base01 in the unfocused panel.
	default: "rgb({{base05_rgb}}) rgb({{base00_rgb}}) / rgb({{base04_rgb}}) rgb({{base01_rgb}})"
	tree: "rgb({{base02_rgb}}) none"                                 // base02 — --border
	selected_line: "none rgb({{base02_rgb}}) / none rgb({{base01_rgb}})"
	input: "rgb({{base05_rgb}}) none"
	flag_label: "rgb({{base04_rgb}}) none"                        // base04
	flag_value: "rgb({{base0A_rgb}}) none bold"                     // base0A
	scrollbar_track: "rgb({{base01_rgb}}) none"                      // base01
	scrollbar_thumb: "rgb({{base03_rgb}}) none"                   // base03
	mode_command_mark: "rgb({{base00_rgb}}) rgb({{base0E_rgb}}) bold" // base00 on base0E

	// --- Entries -------------------------------------------------------------
	file: "rgb({{base05_rgb}}) none"                              // base05
	parent: "rgb({{base04_rgb}}) none"                            // base04
	directory: "rgb({{base0D_rgb}}) none bold"                     // base0D — like helix headings
	exe: "rgb({{base0B_rgb}}) none"                               // base0B
	link: "rgb({{base0C_rgb}}) none"                              // base0C
	pruning: "rgb({{base03_rgb}}) none italic"                    // base03 — same slot as comments
	char_match: "rgb({{base0A_rgb}}) none bold"                     // base0A — search highlight
	file_error: "rgb({{base08_rgb}}) none italic"                   // base08
	content_extract: "rgb({{base0B_rgb}}) none"                   // base0B — matched file content
	content_match: "rgb({{base0A_rgb}}) none bold"                  // base0A

	// --- Metadata columns ----------------------------------------------------
	perm__: "rgb({{base03_rgb}}) none"                            // base03
	perm_r: "rgb({{base0A_rgb}}) none"                              // base0A
	perm_w: "rgb({{base08_rgb}}) none"                              // base08
	perm_x: "rgb({{base0B_rgb}}) none"                            // base0B
	owner: "rgb({{base04_rgb}}) none"                             // base04
	group: "rgb({{base04_rgb}}) none"                             // base04
	sparse: "rgb({{base09_rgb}}) none"                             // base09
	dates: "rgb({{base04_rgb}}) none"                             // base04
	count: "rgb({{base04_rgb}}) none"                             // base04
	device_id_major: "rgb({{base0C_rgb}}) none"                   // base0C
	device_id_sep: "rgb({{base03_rgb}}) none"                     // base03
	device_id_minor: "rgb({{base0C_rgb}}) none"                   // base0C

	// --- Git -----------------------------------------------------------------
	// Same slots delta uses for the equivalent states.
	git_branch: "rgb({{base0A_rgb}}) none"                          // base0A
	git_insertions: "rgb({{base0B_rgb}}) none"                    // base0B
	git_deletions: "rgb({{base08_rgb}}) none"                       // base08
	git_status_current: "rgb({{base03_rgb}}) none"                // base03
	git_status_modified: "rgb({{base09_rgb}}) none"                // base09
	git_status_new: "rgb({{base0B_rgb}}) none bold"               // base0B
	git_status_ignored: "rgb({{base03_rgb}}) none"                // base03
	git_status_conflicted: "rgb({{base08_rgb}}) none"               // base08
	git_status_other: "rgb({{base08_rgb}}) none"                    // base08

	// --- Status line ---------------------------------------------------------
	// base01 bar, matching helix's statusline and zellij's unselected ribbon.
	status_normal: "rgb({{base05_rgb}}) rgb({{base01_rgb}})"
	status_italic: "rgb({{base0A_rgb}}) rgb({{base01_rgb}}) italic"
	status_bold: "rgb({{base05_rgb}}) rgb({{base01_rgb}}) bold"
	status_ellipsis: "rgb({{base04_rgb}}) rgb({{base01_rgb}})"
	status_code: "rgb({{base0E_rgb}}) rgb({{base01_rgb}})"            // base0E
	status_error: "rgb({{base00_rgb}}) rgb({{base08_rgb}}) bold"        // base00 on base08
	status_job: "rgb({{base09_rgb}}) rgb({{base01_rgb}}) bold"         // base09

	// --- Verb / purpose panel ------------------------------------------------
	purpose_normal: "rgb({{base05_rgb}}) rgb({{base01_rgb}})"
	purpose_italic: "rgb({{base0A_rgb}}) rgb({{base01_rgb}}) italic"
	purpose_bold: "rgb({{base0A_rgb}}) rgb({{base01_rgb}}) bold"
	purpose_ellipsis: "rgb({{base04_rgb}}) rgb({{base01_rgb}})"

	// --- Help ----------------------------------------------------------------
	help_paragraph: "rgb({{base05_rgb}}) none"
	help_bold: "rgb({{base0A_rgb}}) none bold"                      // base0A
	help_italic: "rgb({{base0E_rgb}}) none italic"                // base0E
	help_code: "rgb({{base0B_rgb}}) rgb({{base01_rgb}})"              // base0B on base01
	help_headers: "rgb({{base0D_rgb}}) none bold"                  // base0D
	help_table_border: "rgb({{base02_rgb}}) none"                    // base02

	// --- Preview panel -------------------------------------------------------
	preview_title: "rgb({{base05_rgb}}) rgb({{base01_rgb}})"
	preview: "rgb({{base05_rgb}}) rgb({{base00_rgb}}) / rgb({{base04_rgb}}) rgb({{base01_rgb}})"
	preview_line_number: "rgb({{base03_rgb}}) rgb({{base00_rgb}})"
	preview_match: "rgb({{base00_rgb}}) rgb({{base0A_rgb}})"            // base00 on base0A
	preview_separator: "rgb({{base02_rgb}}) none"                    // base02

	// --- Hex preview ---------------------------------------------------------
	hex_null: "rgb({{base03_rgb}}) none"                          // base03
	hex_ascii_graphic: "rgb({{base05_rgb}}) none"                 // base05
	hex_ascii_whitespace: "rgb({{base0C_rgb}}) none"              // base0C
	hex_ascii_other: "rgb({{base09_rgb}}) none"                    // base09
	hex_non_ascii: "rgb({{base08_rgb}}) none"                       // base08

	// --- Staging area --------------------------------------------------------
	staging_area_title: "rgb({{base05_rgb}}) rgb({{base01_rgb}})"

	// --- good_to_bad ramp ----------------------------------------------------
	// Used for the size/usage gauges: green → yellow → orange → red, stepping
	// through base0B, base0A, base09 and base08 with midpoints between them, so
	// the gauge stays inside the palette instead of using the ANSI table.
	good_to_bad_0: rgb({{base0B_rgb}})                            // base0B
	good_to_bad_1: rgb({{base0B_rgb}})
	good_to_bad_2: rgb({{ mix_rgb('base0B','base0A',50) }})
	good_to_bad_3: rgb({{base0A_rgb}})                              // base0A
	good_to_bad_4: rgb({{base0A_rgb}})
	good_to_bad_5: rgb({{ mix_rgb('base0A','base09',50) }})
	good_to_bad_6: rgb({{base09_rgb}})                             // base09
	good_to_bad_7: rgb({{base09_rgb}})
	good_to_bad_8: rgb({{ mix_rgb('base09','base08',50) }})
	good_to_bad_9: rgb({{base08_rgb}})                              // base08
}

// broot's file preview uses syntect with one of six embedded themes and cannot
// load an external one, so this is the nearest available rather than a port of
// the scheme — the one place in the loadout where a preview pane is off-scheme.
// Picked by the scheme's luma, which is the only decision in the build that
// cares whether the scheme is dark or light.
syntax_theme: {% if dark %}OceanDark{% endif %}{% if light %}GitHub{% endif %}
