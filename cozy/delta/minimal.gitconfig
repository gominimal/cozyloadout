# delta — Minimal base16 (see COLOURS.md).
#
# delta has no config file of its own; it reads its settings out of git config.
# This file is therefore an *include*, not a replacement for your ~/.gitconfig —
# the loadout drops it at ~/.config/git/minimal-delta.gitconfig and you point
# git at it once:
#
#     git config --global include.path ~/.config/git/minimal-delta.gitconfig
#
# `just delta-include` runs exactly that. It is deliberately not automatic:
# clobbering a user's gitconfig to set a colour scheme would take your name,
# email and remotes with it.
#
# Syntax highlighting inside diffs comes from bat's theme cache, so this depends
# on cozy/bat/themes/minimal-*.tmTheme being installed and `bat cache --build`
# having been run.
#
# Every style value is quoted on purpose: in git config `#` starts a comment, so
# an unquoted `minus-style = syntax #341919` parses as an empty value and delta
# silently falls back to its defaults.

[delta]
	# Switch the whole scheme by pointing this at "minimal-light".
	features = minimal-dark

	# The line-numbers-*-style settings below only render with this on.
	line-numbers = true

# --- Minimal Dark ------------------------------------------------------------
[delta "minimal-dark"]
	dark = true
	syntax-theme = minimal-dark

	# Diff bodies. Foreground stays "syntax" so bat's highlighting survives; the
	# backgrounds are base08/base0B blended into base00 at 15% (body) and 30%
	# (emphasised word-level change) — see COLOURS.md.
	minus-style = "syntax #341919"
	minus-emph-style = "syntax #541e1e"
	minus-non-emph-style = "syntax #341919"
	plus-style = "syntax #242f28"
	plus-emph-style = "syntax #344a3b"
	plus-non-emph-style = "syntax #242f28"
	zero-style = "syntax"
	whitespace-error-style = "#141414 #e93535"

	# Gutter
	line-numbers-minus-style = "#e93535"
	line-numbers-plus-style = "#7ec897"
	line-numbers-zero-style = "#666666"
	line-numbers-left-style = "#3d3d3d"
	line-numbers-right-style = "#3d3d3d"

	# Headers — blue file names and yellow commits, matching helix's headings
	# and zellij's active ribbon.
	file-style = "bold #4a7aff"
	file-decoration-style = "#3d3d3d ul"
	hunk-header-style = "file line-number syntax"
	hunk-header-decoration-style = "#3d3d3d box"
	hunk-header-file-style = "#8f8f8f"
	hunk-header-line-number-style = "#dd8440"
	commit-style = "bold #cca300"
	commit-decoration-style = "#3d3d3d box"

	# `git blame` via delta: base00 → base01 → base02 as the block ages.
	blame-code-style = "syntax"
	blame-palette = "#141414 #292929 #3d3d3d"

	# `delta --grep` / rg piped through delta
	grep-file-style = "#4a7aff"
	grep-line-number-style = "#dd8440"

	merge-conflict-ours-diff-header-style = "bold #cca300"
	merge-conflict-ours-diff-header-decoration-style = "#3d3d3d box"
	merge-conflict-theirs-diff-header-style = "bold #cca300"
	merge-conflict-theirs-diff-header-decoration-style = "#3d3d3d box"

# --- Minimal Light -----------------------------------------------------------
[delta "minimal-light"]
	light = true
	syntax-theme = minimal-light

	minus-style = "syntax #ecd3d3"
	minus-emph-style = "syntax #e3b2b2"
	minus-non-emph-style = "syntax #ecd3d3"
	plus-style = "syntax #d8e1db"
	plus-emph-style = "syntax #bacec1"
	plus-non-emph-style = "syntax #d8e1db"
	zero-style = "syntax"
	whitespace-error-style = "#f5f5f5 #b81414"

	line-numbers-minus-style = "#b81414"
	line-numbers-plus-style = "#317247"
	line-numbers-zero-style = "#666666"
	line-numbers-left-style = "#cccccc"
	line-numbers-right-style = "#cccccc"

	file-style = "bold #2850bd"
	file-decoration-style = "#cccccc ul"
	hunk-header-style = "file line-number syntax"
	hunk-header-decoration-style = "#cccccc box"
	hunk-header-file-style = "#3d3d3d"
	hunk-header-line-number-style = "#8b4a18"
	commit-style = "bold #7a6200"
	commit-decoration-style = "#cccccc box"

	blame-code-style = "syntax"
	blame-palette = "#f5f5f5 #ebebeb #cccccc"

	grep-file-style = "#2850bd"
	grep-line-number-style = "#8b4a18"

	merge-conflict-ours-diff-header-style = "bold #7a6200"
	merge-conflict-ours-diff-header-decoration-style = "#cccccc box"
	merge-conflict-theirs-diff-header-style = "bold #7a6200"
	merge-conflict-theirs-diff-header-decoration-style = "#cccccc box"
