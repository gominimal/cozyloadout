// Minimal base16 themes for zellij.
// Generated from cozy/base16/minimal-{dark,light}.yaml — see COLOURS.md.
//
// Uses zellij's UI-component theme spec (0.41+), not the legacy base-colors
// block: the component spec states every surface explicitly, so the light
// variant doesn't have to fight the legacy format's dark-theme assumptions.
//
// Switch with `theme "minimal-dark"` / `theme "minimal-light"` in config.kdl.

themes {
    minimal-dark {
        // Body text — base05 on base00
        text_unselected {
            base "#e0e0e0"
            background "#141414"
            emphasis_0 "#dd8440" // base09 orange
            emphasis_1 "#4a7aff" // base0D blue
            emphasis_2 "#7ec897" // base0B green
            emphasis_3 "#aa81da" // base0E purple
        }
        text_selected {
            base "#e0e0e0"
            background "#3d3d3d" // base02 — selection
            emphasis_0 "#dd8440"
            emphasis_1 "#4a7aff"
            emphasis_2 "#7ec897"
            emphasis_3 "#aa81da"
        }

        // Active mode/tab ribbon — blue, matching helix's NORMAL statusline
        ribbon_selected {
            base "#141414"
            background "#4a7aff" // base0D
            emphasis_0 "#141414"
            emphasis_1 "#ffffff"
            emphasis_2 "#141414"
            emphasis_3 "#ffffff"
        }
        ribbon_unselected {
            base "#8f8f8f" // base04 — --muted-foreground
            background "#292929" // base01 — --card
            emphasis_0 "#dd8440"
            emphasis_1 "#e0e0e0"
            emphasis_2 "#7ec897"
            emphasis_3 "#aa81da"
        }

        table_title {
            base "#4a7aff" // base0D — headings
            background "#141414"
            emphasis_0 "#dd8440"
            emphasis_1 "#4a7aff"
            emphasis_2 "#7ec897"
            emphasis_3 "#aa81da"
        }
        table_cell_unselected {
            base "#e0e0e0"
            background "#141414"
            emphasis_0 "#dd8440"
            emphasis_1 "#4a7aff"
            emphasis_2 "#7ec897"
            emphasis_3 "#aa81da"
        }
        table_cell_selected {
            base "#e0e0e0"
            background "#3d3d3d"
            emphasis_0 "#dd8440"
            emphasis_1 "#4a7aff"
            emphasis_2 "#7ec897"
            emphasis_3 "#aa81da"
        }

        list_unselected {
            base "#e0e0e0"
            background "#141414"
            emphasis_0 "#dd8440"
            emphasis_1 "#4a7aff"
            emphasis_2 "#7ec897"
            emphasis_3 "#aa81da"
        }
        list_selected {
            base "#e0e0e0"
            background "#3d3d3d"
            emphasis_0 "#dd8440"
            emphasis_1 "#4a7aff"
            emphasis_2 "#7ec897"
            emphasis_3 "#aa81da"
        }

        // Pane frames
        frame_unselected {
            base "#3d3d3d" // base02 — --border
            emphasis_0 "#dd8440"
            emphasis_1 "#4a7aff"
            emphasis_2 "#7ec897"
            emphasis_3 "#aa81da"
        }
        frame_selected {
            base "#4a7aff" // base0D — focused pane
            emphasis_0 "#dd8440"
            emphasis_1 "#4a7aff"
            emphasis_2 "#7ec897"
            emphasis_3 "#aa81da"
        }
        frame_highlight {
            base "#dd8440" // base09 — search / rename
            emphasis_0 "#e93535"
            emphasis_1 "#dd8440"
            emphasis_2 "#cca300"
            emphasis_3 "#aa81da"
        }

        exit_code_success {
            base "#7ec897" // base0B
            background "#141414"
            emphasis_0 "#cca300"
            emphasis_1 "#4a7aff"
            emphasis_2 "#7ec897"
            emphasis_3 "#aa81da"
        }
        exit_code_error {
            base "#e93535" // base08
            background "#141414"
            emphasis_0 "#cca300"
            emphasis_1 "#4a7aff"
            emphasis_2 "#7ec897"
            emphasis_3 "#aa81da"
        }

        multiplayer_user_colors {
            player_1 "#4a7aff" // base0D
            player_2 "#aa81da" // base0E
            player_3 "#7ec897" // base0B
            player_4 "#dd8440" // base09
            player_5 "#6bbec7" // base0C
            player_6 "#cca300" // base0A
            player_7 "#e93535" // base08
            player_8 "#af715a" // base0F
            player_9 "#8f8f8f" // base04
            player_10 "#ebebeb" // base06
        }
    }

    minimal-light {
        text_unselected {
            base "#141414"
            background "#f5f5f5"
            emphasis_0 "#8b4a18" // base09 orange
            emphasis_1 "#2850bd" // base0D blue
            emphasis_2 "#317247" // base0B green
            emphasis_3 "#7743b1" // base0E purple
        }
        text_selected {
            base "#141414"
            background "#cccccc" // base02 — selection
            emphasis_0 "#8b4a18"
            emphasis_1 "#2850bd"
            emphasis_2 "#317247"
            emphasis_3 "#7743b1"
        }

        ribbon_selected {
            base "#f5f5f5"
            background "#2850bd" // base0D
            emphasis_0 "#f5f5f5"
            emphasis_1 "#ffffff"
            emphasis_2 "#f5f5f5"
            emphasis_3 "#ffffff"
        }
        ribbon_unselected {
            base "#666666" // base03 — --muted-foreground
            background "#ebebeb" // base01
            emphasis_0 "#8b4a18"
            emphasis_1 "#141414"
            emphasis_2 "#317247"
            emphasis_3 "#7743b1"
        }

        table_title {
            base "#2850bd"
            background "#f5f5f5"
            emphasis_0 "#8b4a18"
            emphasis_1 "#2850bd"
            emphasis_2 "#317247"
            emphasis_3 "#7743b1"
        }
        table_cell_unselected {
            base "#141414"
            background "#f5f5f5"
            emphasis_0 "#8b4a18"
            emphasis_1 "#2850bd"
            emphasis_2 "#317247"
            emphasis_3 "#7743b1"
        }
        table_cell_selected {
            base "#141414"
            background "#cccccc"
            emphasis_0 "#8b4a18"
            emphasis_1 "#2850bd"
            emphasis_2 "#317247"
            emphasis_3 "#7743b1"
        }

        list_unselected {
            base "#141414"
            background "#f5f5f5"
            emphasis_0 "#8b4a18"
            emphasis_1 "#2850bd"
            emphasis_2 "#317247"
            emphasis_3 "#7743b1"
        }
        list_selected {
            base "#141414"
            background "#cccccc"
            emphasis_0 "#8b4a18"
            emphasis_1 "#2850bd"
            emphasis_2 "#317247"
            emphasis_3 "#7743b1"
        }

        frame_unselected {
            base "#cccccc" // base02 — --border
            emphasis_0 "#8b4a18"
            emphasis_1 "#2850bd"
            emphasis_2 "#317247"
            emphasis_3 "#7743b1"
        }
        frame_selected {
            base "#2850bd"
            emphasis_0 "#8b4a18"
            emphasis_1 "#2850bd"
            emphasis_2 "#317247"
            emphasis_3 "#7743b1"
        }
        frame_highlight {
            base "#8b4a18" // base09
            emphasis_0 "#b81414"
            emphasis_1 "#8b4a18"
            emphasis_2 "#7a6200"
            emphasis_3 "#7743b1"
        }

        exit_code_success {
            base "#317247"
            background "#f5f5f5"
            emphasis_0 "#7a6200"
            emphasis_1 "#2850bd"
            emphasis_2 "#317247"
            emphasis_3 "#7743b1"
        }
        exit_code_error {
            base "#b81414"
            background "#f5f5f5"
            emphasis_0 "#7a6200"
            emphasis_1 "#2850bd"
            emphasis_2 "#317247"
            emphasis_3 "#7743b1"
        }

        multiplayer_user_colors {
            player_1 "#2850bd" // base0D
            player_2 "#7743b1" // base0E
            player_3 "#317247" // base0B
            player_4 "#8b4a18" // base09
            player_5 "#2d6f76" // base0C
            player_6 "#7a6200" // base0A
            player_7 "#b81414" // base08
            player_8 "#754938" // base0F
            player_9 "#3d3d3d" // base04
            player_10 "#0a0a0a" // base06
        }
    }
}
