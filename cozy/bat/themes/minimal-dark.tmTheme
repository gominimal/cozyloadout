<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Minimal Dark — generated from cozy/base16/minimal-dark.yaml
  Palette provenance and design rationale: see COLOURS.md at the repo root.

  Sublime .tmTheme is the only format bat (and therefore delta) can load, so
  this is a hand-maintained port of the base16 slots rather than a base16 file.
  Scope assignments mirror cozy/helix/themes/minimal-dark.toml as closely as the
  TextMate scope vocabulary allows, so a file read in bat and the same file open
  in helix are coloured the same way.

  bat takes the theme name from the *file stem*, not the <key>name</key> below;
  both are kept in sync anyway. Rebuild bat's cache after changing this file:
      bat cache --build
-->
<plist version="1.0">
<dict>
	<key>name</key>
	<string>minimal-dark</string>
	<key>semanticClass</key>
	<string>theme.dark.minimal_dark</string>
	<key>uuid</key>
	<string>6d696e69-6d61-4c64-972b-6d696e646b00</string>
	<key>colorSpaceName</key>
	<string>sRGB</string>
	<key>author</key>
	<string>Minimal System (gominimal)</string>
	<key>settings</key>
	<array>
		<!-- Editor surface: base00 / base05, base02 selection, base01 line highlight -->
		<dict>
			<key>settings</key>
			<dict>
				<key>background</key>
				<string>#141414</string>
				<key>foreground</key>
				<string>#e0e0e0</string>
				<key>caret</key>
				<string>#e0e0e0</string>
				<key>invisibles</key>
				<string>#666666</string>
				<key>lineHighlight</key>
				<string>#292929</string>
				<key>selection</key>
				<string>#3d3d3d</string>
				<key>selectionBorder</key>
				<string>#3d3d3d</string>
				<key>findHighlight</key>
				<string>#cca300</string>
				<key>findHighlightForeground</key>
				<string>#141414</string>
				<key>gutter</key>
				<string>#141414</string>
				<key>gutterForeground</key>
				<string>#666666</string>
				<key>activeGuide</key>
				<string>#3d3d3d</string>
				<key>guide</key>
				<string>#292929</string>
				<key>stackGuide</key>
				<string>#3d3d3d</string>
			</dict>
		</dict>

		<!-- ============================ Syntax ============================ -->
		<dict>
			<key>name</key>
			<string>Comment</string>
			<key>scope</key>
			<string>comment, punctuation.definition.comment</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#666666</string>
				<key>fontStyle</key>
				<string>italic</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Variable</string>
			<key>scope</key>
			<string>variable, variable.other, variable.parameter, meta.block variable.other</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#e0e0e0</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Builtin variable, member, mapping key</string>
			<key>scope</key>
			<string>variable.language, variable.other.member, support.other.variable, meta.mapping.key string, meta.object-literal.key</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#e93535</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
