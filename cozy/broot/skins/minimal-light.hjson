// Minimal Light — generated from cozy/base16/minimal-light.yaml
// Palette provenance and design rationale: see COLOURS.md at the repo root.
//
// broot skin entries are "foreground background attributes", with a second
// "/ foreground background" group for the unfocused panel. `none` means "leave
// it to the terminal". The key set below is broot's full one (checked against
// the skins broot ships) — unknown keys are ignored silently, so a typo shows
// up as an unstyled widget rather than an error.
//
// Skin reference: https://dystroy.org/broot/skins/

skin: {
	// --- Surfaces ------------------------------------------------------------
	// base05 on base00, dimming to base04 on base01 in the unfocused panel.
	default: "rgb(20, 20, 20) rgb(245, 245, 245) / rgb(61, 61, 61) rgb(235, 235, 235)"
	tree: "rgb(204, 204, 204) none"                                // base02 — --border
	selected_line: "none rgb(204, 204, 204) / none rgb(235, 235, 235)"
	input: "rgb(20, 20, 20) none"
	flag_label: "rgb(61, 61, 61) none"                             // base04
	flag_value: "rgb(122, 98, 0) none bold"                        // base0A
	scrollbar_track: "rgb(235, 235, 235) none"                     // base01
	scrollbar_thumb: "rgb(102, 102, 102) none"                     // base03
	mode_command_mark: "rgb(245, 245, 245) rgb(119, 67, 177) bold" // base00 on base0E

	// --- Entries -------------------------------------------------------------
	file: "rgb(20, 20, 20) none"                                   // base05
	parent: "rgb(61, 61, 61) none"                                 // base04
	directory: "rgb(40, 80, 189) none bold"                        // base0D — like helix headings
	exe: "rgb(49, 114, 71) none"                                   // base0B
	link: "rgb(45, 111, 118) none"                                 // base0C
	pruning: "rgb(102, 102, 102) none italic"                      // base03 — same slot as comments
	char_match: "rgb(122, 98, 0) none bold"                        // base0A — search highlight
	file_error: "rgb(184, 20, 20) none italic"                     // base08
	content_extract: "rgb(49, 114, 71) none"                       // base0B — matched file content
	content_match: "rgb(122, 98, 0) none bold"                     // base0A

	// --- Metadata columns ----------------------------------------------------
	perm__: "rgb(102, 102, 102) none"                              // base03
	perm_r: "rgb(122, 98, 0) none"                                 // base0A
	perm_w: "rgb(184, 20, 20) none"                                // base08
	perm_x: "rgb(49, 114, 71) none"                                // base0B
	owner: "rgb(61, 61, 61) none"                                  // base04
	group: "rgb(61, 61, 61) none"                                  // base04
	sparse: "rgb(139, 74, 24) none"                                // base09
	dates: "rgb(61, 61, 61) none"                                  // base04
	count: "rgb(61, 61, 61) none"                                  // base04
	device_id_major: "rgb(45, 111, 118) none"                      // base0C
	device_id_sep: "rgb(102, 102, 102) none"                       // base03
	device_id_minor: "rgb(45, 111, 118) none"                      // base0C

	// --- Git -----------------------------------------------------------------
	// Same slots delta uses for the equivalent states.
	git_branch: "rgb(122, 98, 0) none"                             // base0A
	git_insertions: "rgb(49, 114, 71) none"                        // base0B
	git_deletions: "rgb(184, 20, 20) none"                         // base08
	git_status_current: "rgb(102, 102, 102) none"                  // base03
	git_status_modified: "rgb(139, 74, 24) none"                   // base09
	git_status_new: "rgb(49, 114, 71) none bold"                   // base0B
	git_status_ignored: "rgb(102, 102, 102) none"                  // base03
	git_status_conflicted: "rgb(184, 20, 20) none"                 // base08
	git_status_other: "rgb(184, 20, 20) none"                      // base08

	// --- Status line ---------------------------------------------------------
	// base01 bar, matching helix's statusline and zellij's unselected ribbon.
	status_normal: "rgb(20, 20, 20) rgb(235, 235, 235)"
	status_italic: "rgb(122, 98, 0) rgb(235, 235, 235) italic"
	status_bold: "rgb(20, 20, 20) rgb(235, 235, 235) bold"
	status_ellipsis: "rgb(61, 61, 61) rgb(235, 235, 235)"
	status_code: "rgb(119, 67, 177) rgb(235, 235, 235)"            // base0E
	status_error: "rgb(245, 245, 245) rgb(184, 20, 20) bold"       // base00 on base08
	status_job: "rgb(139, 74, 24) rgb(235, 235, 235) bold"         // base09

	// --- Verb / purpose panel ------------------------------------------------
	purpose_normal: "rgb(20, 20, 20) rgb(235, 235, 235)"
	purpose_italic: "rgb(122, 98, 0) rgb(235, 235, 235) italic"
	purpose_bold: "rgb(122, 98, 0) rgb(235, 235, 235) bold"
	purpose_ellipsis: "rgb(61, 61, 61) rgb(235, 235, 235)"

	// --- Help ----------------------------------------------------------------
	help_paragraph: "rgb(20, 20, 20) none"
	help_bold: "rgb(122, 98, 0) none bold"                         // base0A
	help_italic: "rgb(119, 67, 177) none italic"                   // base0E
	help_code: "rgb(49, 114, 71) rgb(235, 235, 235)"               // base0B on base01
	help_headers: "rgb(40, 80, 189) none bold"                     // base0D
	help_table_border: "rgb(204, 204, 204) none"                   // base02

	// --- Preview panel -------------------------------------------------------
	preview_title: "rgb(20, 20, 20) rgb(235, 235, 235)"
	preview: "rgb(20, 20, 20) rgb(245, 245, 245) / rgb(61, 61, 61) rgb(235, 235, 235)"
	preview_line_number: "rgb(102, 102, 102) rgb(245, 245, 245)"
	preview_match: "rgb(245, 245, 245) rgb(122, 98, 0)"            // base00 on base0A
	preview_separator: "rgb(204, 204, 204) none"                   // base02

	// --- Hex preview ---------------------------------------------------------
	hex_null: "rgb(102, 102, 102) none"                            // base03
	hex_ascii_graphic: "rgb(20, 20, 20) none"                      // base05
	hex_ascii_whitespace: "rgb(45, 111, 118) none"                 // base0C
	hex_ascii_other: "rgb(139, 74, 24) none"                       // base09
	hex_non_ascii: "rgb(184, 20, 20) none"                         // base08

	// --- Staging area --------------------------------------------------------
	staging_area_title: "rgb(20, 20, 20) rgb(235, 235, 235)"

	// --- good_to_bad ramp ----------------------------------------------------
	// Used for the size/usage gauges: green → yellow → orange → red, stepping
	// through base0B, base0A, base09 and base08 with midpoints between them, so
	// the gauge stays inside the palette instead of using the ANSI table.
	good_to_bad_0: rgb(49, 114, 71)                                // base0B
	good_to_bad_1: rgb(49, 114, 71)
	good_to_bad_2: rgb(85, 106, 35)
	good_to_bad_3: rgb(122, 98, 0)                                 // base0A
	good_to_bad_4: rgb(122, 98, 0)
	good_to_bad_5: rgb(130, 86, 12)
	good_to_bad_6: rgb(139, 74, 24)                                // base09
	good_to_bad_7: rgb(139, 74, 24)
	good_to_bad_8: rgb(161, 47, 22)
	good_to_bad_9: rgb(184, 20, 20)                                // base08
}

// broot's file preview uses syntect with one of six embedded themes and cannot
// load an external one, so this is the closest available rather than a port of
// the palette — the one place in the loadout where a preview pane is off-scheme.
syntax_theme: GitHub
